@echo off
chcp 65001 >nul
title 浮出水面 (Surface) —— 双人实时在线猜词 (联机守护启动器)

echo ========================================================
echo       正在启动「浮出水面 (Surface)」双人在线联机服务...
echo ========================================================
echo.
cd /d "%~dp0"

:keepalive
node scripts/share.js
echo.
echo ========================================================
echo [守护监视器] 检测到联机进程意外退出，正在 3 秒后自动自愈恢复...
echo （如需完全停止游戏联机，请直接关闭当前黑框窗口即可）
echo ========================================================
timeout /t 3 >nul
goto keepalive
