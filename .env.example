# ==========================================
# 浮出水面 (Surface) - 环境变量配置模板
# ==========================================

# 1. 运行模式与数据存储引擎
# 可选值: 'local' (默认本地内存/SSE实时广播，无需任何外部账号即可双人联机)
# 或 'supabase' (使用 Supabase Postgres 与 Realtime 进行云端长久部署)
DATA_PROVIDER=local

# 2. AI 智能辅助配置（二选一即可，不配置亦可完整体验全部核心问答与词库）
# 【推荐方案 A：DeepSeek（国内网络直接可用，无需翻墙）】
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 【方案 B：Google Gemini 官方大模型（需支持的境外节点）】
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-3.8-flash

# 3. Supabase 配置 (仅当 DATA_PROVIDER=supabase 时需要配置)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
